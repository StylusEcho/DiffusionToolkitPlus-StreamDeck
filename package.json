{
  "name": "diffusiontoolkitplus-streamdeck",
  "version": "1.0.0",
  "description": "Stream Deck plugin for Diffusion Toolkit Plus",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c && npm run validate",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.stylusecho.dtplus\"",
    "typecheck": "tsc --noEmit",
    "icons": "python3 tools/generate-icons.py",
    "validate": "node tools/validate-manifest.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "test": "tsc src/client.ts --outDir dist-test --module es2022 --target es2022 --moduleResolution bundler --skipLibCheck && node tools/test-client.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "rollup": "^4.63.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.5.1"
  }
}
